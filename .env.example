# URL publique du site (sans / final). Sert aux redirections OAuth.
ORIGIN=http://localhost:5173

# Fichier SQLite
DATABASE_PATH=./data/tindify.db

# Clé de chiffrement des tokens Spotify : 32 octets en hex.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Application OAuth 42 (intra > Settings > API). Redirect URI : $ORIGIN/auth/42/callback
UID_42=
SECRET_42=
# Campus autorisé (nom tel que renvoyé par l'API 42)
ALLOWED_CAMPUS=Lausanne
# Login 42 qui reçoit les droits admin
ADMIN_LOGIN=

# Application Spotify (developer.spotify.com). Redirect URI : $ORIGIN/auth/spotify/callback
UID_SPOTI=
SECRET_SPOTI=
